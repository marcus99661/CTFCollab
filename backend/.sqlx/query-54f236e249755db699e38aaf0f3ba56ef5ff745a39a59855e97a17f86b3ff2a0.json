  "query": "\n                SELECT id, event_id, title, category, points, url, created_at, updated_at, is_deleted, note_id\n                FROM challenges\n                WHERE (updated_at > $1) OR (updated_at = $1 AND id > $2)\n                ORDER BY updated_at ASC, id ASC\n                LIMIT $3\n                ",
